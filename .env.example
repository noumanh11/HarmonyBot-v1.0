# Copy to .env and fill in. Never commit the real .env.

# Required: a Hugging Face token with inference access.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Model served through HF Inference Providers.
MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# Generation
MAX_TOKENS=512
TEMPERATURE=0.7

# Retrieval. Set ENABLE_RETRIEVAL=false to boot without downloading the
# datasets (useful offline, in CI, or for a fast first start).
ENABLE_RETRIEVAL=true
MAX_INDEX_ROWS=20000
TOP_K=2
MIN_SIMILARITY=0.12

# Conversation memory
MAX_HISTORY_TURNS=8
SESSION_TTL_SECONDS=3600

# Server
HOST=127.0.0.1
PORT=7860
